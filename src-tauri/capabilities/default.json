{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": { "urls": ["*://*:*/*"] },
  "permissions": [
    "core:default",
    "opener:default",
    "process:default",
    "allow-shutdown",
    "allow-read-url",
    "allow-update-url"
  ]
}
